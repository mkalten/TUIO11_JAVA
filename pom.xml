<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.tuio</groupId>
  <artifactId>libtuio</artifactId>
  <version>1.1.6</version>
  <packaging>jar</packaging>

  <name>TUIO Library</name>
  <description>TUIO protocol library for Java — OSC codec, client, server and transports</description>
  <url>https://github.com/mkalten/TUIO11_JAVA</url>

  <licenses>
    <license>
      <name>LGPL-3.0-or-later</name>
      <url>https://www.gnu.org/licenses/lgpl-3.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Martin Kaltenbrunner</name>
      <email>martin@tuio.org</email>
      <organizationUrl>https://www.tuio.org/</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/mkalten/TUIO11_JAVA.git</connection>
    <developerConnection>scm:git:git@github.com:mkalten/TUIO11_JAVA.git</developerConnection>
    <url>https://github.com/mkalten/TUIO11_JAVA</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>8</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- preserve the legacy jar name -->
    <finalName>libTUIO</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>8</release>
          <compilerArgs>
            <arg>-Xlint:-options</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <!-- the library jar excludes the demo applications in the default package -->
          <excludes>
            <exclude>TuioDemo*.class</exclude>
            <exclude>TuioDump*.class</exclude>
            <exclude>SimpleSimulator*.class</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>tuioDemo</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
            <configuration>
              <finalName>TuioDemo</finalName>
              <appendAssemblyId>false</appendAssemblyId>
              <attach>false</attach>
              <descriptors>
                <descriptor>src/assembly/tuio-demo.xml</descriptor>
              </descriptors>
              <archive>
                <manifest>
                  <mainClass>TuioDemo</mainClass>
                </manifest>
              </archive>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.12.0</version>
        <configuration>
          <encoding>UTF-8</encoding>
          <charset>UTF-8</charset>
          <docencoding>UTF-8</docencoding>
          <!-- legacy javadoc style; disable strict doclint checks on modern JDKs -->
          <additionalOptions>
            <additionalOption>-Xdoclint:none</additionalOption>
          </additionalOptions>
          <detectJavaApiLink>true</detectJavaApiLink>
          <bottom>Copyright (c) 2005-2026 Martin Kaltenbrunner — LGPL</bottom>
          <!-- the library jar excludes the demo applications in the default package -->
          <sourceFileExcludes>
            <exclude>TuioDemo.java</exclude>
            <exclude>TuioDump.java</exclude>
            <exclude>SimpleSimulator.java</exclude>
          </sourceFileExcludes>
          <!-- the OSC codec is documented separately: mvn javadoc:javadoc@osc -->
          <excludePackageNames>TUIO.osc</excludePackageNames>
        </configuration>
        <executions>
          <!-- OSC codec documentation: mvn javadoc:javadoc@osc -->
          <execution>
            <id>osc</id>
            <goals><goal>javadoc</goal></goals>
            <configuration combine.self="override">
              <encoding>UTF-8</encoding>
              <charset>UTF-8</charset>
              <docencoding>UTF-8</docencoding>
              <additionalOptions>
                <additionalOption>-Xdoclint:none</additionalOption>
              </additionalOptions>
              <detectJavaApiLink>true</detectJavaApiLink>
              <bottom>Copyright (c) 2005-2026 Martin Kaltenbrunner — LGPL</bottom>
              <subpackages>TUIO.osc</subpackages>
              <outputDirectory>${project.build.directory}/reports/osc</outputDirectory>
              <doctitle>TUIO OSC Codec ${project.version} API</doctitle>
              <windowtitle>TUIO OSC Codec ${project.version} API</windowtitle>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>central-release</id>
      <properties>
        <central.skipUpload>false</central.skipUpload>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <configuration>
              <excludes>
                <exclude>TuioDemo.java</exclude>
                <exclude>TuioDump.java</exclude>
                <exclude>SimpleSimulator.java</exclude>
              </excludes>
            </configuration>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
              <skipUpload>${central.skipUpload}</skipUpload>
              <deploymentName>TUIO Java Library ${project.version}</deploymentName>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
